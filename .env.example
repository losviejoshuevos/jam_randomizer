# Upstash Redis REST credentials. Without them `npm run dev` uses in-memory rooms.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sliding two-hour lifetime after the latest host heartbeat.
JAM_ROOM_TTL_SECONDS=7200

# Emergency switch: disable Redis/SSE while keeping editor and master Stage Mode.
LIVE_ROOMS_ENABLED=true
NEXT_PUBLIC_LIVE_ROOMS_ENABLED=true
